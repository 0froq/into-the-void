{
  "name": "void-jingle",
  "version": "0.1.0",
  "description": "Play a jingle and print lyrics after a successful void deploy",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "void-jingle": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./on-deploy-success": {
      "types": "./dist/onDeploySuccess.d.ts",
      "import": "./dist/onDeploySuccess.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "deploy": "void-jingle deploy",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "void",
    "deploy",
    "jingle",
    "cli"
  ],
  "author": "froQ",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
